# SatQuery AI Database Configuration
# Copy to .env and set POSTGRES_PASSWORD. .env is gitignored.
POSTGRES_USER=satquery
POSTGRES_PASSWORD=satquery
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=satquery
# Optional full URL override (wins over POSTGRES_* if set):
# DATABASE_URL=postgresql+psycopg://satquery:satquery@127.0.0.1:5432/satquery

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage Configuration
DATA_DIR=data
JOB_STORAGE_PATH=data/jobs

# Geospatial Settings
DEFAULT_SRID=4326

# Qwen2.5-3B-Instruct router (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ROUTER_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SECONDS=180
