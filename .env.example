# SatQuery AI Database Configuration
# Copy to .env and set POSTGRES_PASSWORD. .env is gitignored.
POSTGRES_USER=satquery
POSTGRES_PASSWORD=satquery
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=satquery
# Optional full URL override (wins over POSTGRES_* if set):
# DATABASE_URL=postgresql+psycopg://satquery:satquery@127.0.0.1:5432/satquery

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage Configuration
DATA_DIR=data
JOB_STORAGE_PATH=data/jobs

# Geospatial Settings
DEFAULT_SRID=4326

# Qwen2.5-VL handles both routing/planning and final evidence reasoning (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ROUTER_MODEL=qwen2.5-vl:7b
OLLAMA_TIMEOUT_SECONDS=180

# GeoGround (S2/optical specialist). Leave unset until its real local runtime is integrated.
GEOGROUND_MODEL_PATH=

# SARChat-InternVL2.5-2B (Specialized SAR Model)
SARCHAT_MODEL_PATH=/path/to/SARChat-InternVL2.5-2B
SARCHAT_DEVICE=

# BIT change detector. BIT runs in its isolated Open-CD environment; do not merge
# those dependencies into the main backend environment.
BIT_ROOT=
BIT_CHECKPOINT_PATH=
BIT_PROJECT_NAME=CD_BIT_LEVIR
BIT_CHECKPOINT_NAME=best_ckpt.pt
BIT_IMAGE_SIZE=256
BIT_CLOSE_KERNEL_SIZE=7
BIT_OPEN_KERNEL_SIZE=3
BIT_MIN_REGION_AREA=200

# Analyze UI (Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
