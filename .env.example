# Database Configuration
# Copy to .env and set real credentials. .env is gitignored.
POSTGRES_USER=satquery
POSTGRES_PASSWORD=replace-with-a-secure-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=satquery
# Optional full URL override (wins over POSTGRES_* if set):
DATABASE_URL=postgresql+psycopg://satquery:replace-with-a-secure-password@127.0.0.1:5432/satquery
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Application Environment & Security
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# Vector DB (Qdrant)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# Geospatial Settings
DEFAULT_SRID=4326

# Storage Configuration
DATA_DIR=data
JOB_STORAGE_PATH=data/jobs
WEIGHTS_DIR=weights

# Vision-Language Model (VLM) via OpenRouter API (Server-side secret — never commit real keys)
VLM_PROVIDER=openrouter
VLM_MODEL=google/gemma-4-31b-it:free
VLM_COST_SAFETY_ENFORCE_FREE=true
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=120.0

# Legacy/Fallback Qwen Router via Ollama (Standby)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ROUTER_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT_SECONDS=180.0

# Model Slotting & Weights Architecture
ROUTER_BACKEND=auto
TALKING_VLM_MODEL=OpenGVLab/InternVL3-1B
TALKING_VLM_BACKEND=auto

# Specialist Models
BEN_S1_WEIGHTS_PATH=weights/specialists/ben_s1
BIT_WEIGHTS_PATH=models/BIT_LEVIR_model.onnx

# Analyze UI (Vite CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
